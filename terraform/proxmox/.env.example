# ==============================================================================
# Proxmox VE Deployment Environment Secrets
# Copy this file to '.env' and populate with your credentials:
#   cp .env.example .env
#
# Sourcing this file to populate your environment:
#   - Linux/WSL/macOS: source .env
#   - PowerShell:      Get-Content .env | Foreach-Object { $name, $value = $_.Split('=', 2); if ($name -and $value) { [System.Environment]::SetEnvironmentVariable($name.Trim(), $value.Trim(), [System.EnvironmentVariableTarget]::Process) } }
# ==============================================================================

# --- Terraform PVE API Secrets ---
# The PVE API Token (format: <username>@<realm>!<tokenid>=<uuid>)
export TF_VAR_proxmox_api_token="root@pam!token_name=token_uuid"

# --- Terraform PVE SSH Secrets ---
# The SSH password for the Proxmox VE host (required by bpg/proxmox provider to upload cloud-init user-data snippets)
# Leave empty if you are using 'proxmox_ssh_agent = true' with a loaded SSH key in your local ssh-agent
export TF_VAR_proxmox_ssh_password=""

# Path to your local SSH public key to be installed into the provisioned VMs ('vagrant' user)
export TF_VAR_ssh_public_key_path="~/.ssh/id_rsa.pub"

# --- Ansible SSH Secrets ---
# The path to your local private key corresponding to the public key above.
# This variable is automatically picked up by your updated Ansible group variables!
export PROXMOX_PRIVATE_KEY="~/.ssh/id_rsa"
